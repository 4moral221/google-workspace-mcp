#!/usr/bin/env bash
# Pre-commit hook to prevent committing secrets and project identifiers
set -euo pipefail

# Patterns that should never be committed
PATTERNS=(
  "xyqcevskreoethzwszko"
  "spkbszraxlcdzxaevbao"
  "db\.xyqcevskreoethzwszko\.supabase\.co"
  "Agybot"
  "SUPABASE_SERVICE_ROLE_KEY="
  "GOOGLE_CLIENT_SECRET="
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo "No staged files."
  exit 0
fi

FOUND=0

for file in $STAGED_FILES; do
  # Skip binary files
  if file --mime "$file" | grep -q "text"; then
    for pat in "${PATTERNS[@]}"; do
      if grep -n -E -q "$pat" "$file"; then
        echo "ERROR: Potential secret/identifier found in $file"
        grep -n -E "$pat" "$file"
        FOUND=1
      fi
    done
  fi

  # Block .env files
  if [[ "$file" == .*env* ]]; then
    echo "ERROR: Attempting to commit env file: $file"
    FOUND=1
  fi
done

# Also block common secret formats
if git diff --cached | grep -E -q "sk_[a-zA-Z0-9]{32,}"; then
  echo "ERROR: Possible Supabase service role key detected in staged changes"
  FOUND=1
fi

if [ $FOUND -ne 0 ]; then
  echo ""
  echo "Commit blocked. Remove secrets/identifiers before committing."
  echo "Configure hooks with: git config core.hooksPath .githooks"
  exit 1
fi

echo "Pre-commit checks passed."
exit 0
